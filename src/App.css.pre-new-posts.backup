}

.home-page-shell .home-search {
  border-color: #cbd9ce;
  box-shadow: 0 5px 16px rgba(18, 58, 31, .1);
}

.home-page-shell .home-search > svg {
  color: #137a3d;
}

.home-page-shell .home-search input {
  color: #26372b;
}

.home-page-shell .home-search button {
  background: #137a3d;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
}

.home-page-shell .home-hero-art::before {
  background: linear-gradient(135deg, rgba(19, 122, 61, .15), rgba(15, 56, 88, .04));
}

.home-page-shell .home-section-heading h2 {
  color: #064e2b;
  font-size: 25px;
  font-weight: 700;
}

.home-page-shell .home-section-heading h2 em {
  color: #137a3d;
}

.home-page-shell .home-topic-card {
  border: 1px solid #e1e9e2;
  border-radius: 10px;
  background: #fff;
  color: #25372a;
}

.home-page-shell .home-topic-card:hover {
