}

.home-page-shell .home-topic-blue,
.home-page-shell .home-topic-orange,
.home-page-shell .home-topic-green {
  background: #fff;
}

.home-page-shell .home-topic-blue svg,
.home-page-shell .home-topic-orange svg,
.home-page-shell .home-topic-green svg {
  color: #137a3d;
}

.home-page-shell .home-topic-card strong {
  color: #203326;
  font-size: 16px;
  font-weight: 600;
}

.home-page-shell .home-topic-card small {
