  font-size: 11px;
}

.home-page-shell .home-category-section {
  border-color: #e2e8e3;
  border-radius: 12px;
  box-shadow: 0 5px 18px rgba(21, 48, 29, .045);
}

.home-page-shell .home-category-head h2 {
  color: #173d25;
  font-size: 25px;
  font-weight: 700;
}

.home-page-shell .home-category-all,
.home-page-shell .home-article-meta a {
  color: #137a3d;
  font-size: 12px;
  font-weight: 600;
}

.home-page-shell .home-article-card {
  border-color: #e1e8e2;
  border-radius: 9px;
  box-shadow: 0 3px 12px rgba(27, 44, 30, .05);
}

.home-page-shell .home-article-copy h3 {
  color: #25352a;
  font-size: 18px;
  font-weight: 600;
  line-height: 1.5;
}

.home-page-shell .home-article-copy h3 a {
  color: inherit;
}

.home-page-shell .home-article-copy p {
  color: #5c675e;
  font-size: 13px;
  line-height: 1.7;
}

.home-page-shell .home-article-meta time {
  color: #778078;
  font-size: 11px;
}

.home-page-shell .home-footer-social > div > a {
  border-radius: 5px;
}

@media (max-width: 1050px) {
  .home-page-shell .site-header {
    height: 72px;
  }

  .home-page-shell .header-main.container {
    height: 70px;
    gap: 8px;
  }

  .home-page-shell .brand {
    width: 240px;
    min-width: 240px;
    max-width: 240px;
    flex-basis: 240px;
  }

  .home-page-shell .source-logo {
    width: 240px;
    height: 48px;
  }

  .home-page-shell .desktop-nav {
    display: none;
  }

  .home-page-shell .header-actions {
    min-width: 0;
    flex: 0 0 auto;
    margin-left: auto;
  }

  .home-page-shell .menu-button {
    width: 36px;
    height: 36px;
    display: flex;
  }

  .home-page-shell .reference-news-ticker,
  .home-page-shell .reference-news-label {
    height: 35px;
  }
}

@media (max-width: 680px) {
  .home-page-shell .header-main.container {
    width: calc(100% - 24px);
    padding: 0;
  }

  .home-page-shell .brand {
    width: 200px;
    min-width: 200px;
    max-width: 200px;
    flex-basis: 200px;
  }

  .home-page-shell .source-logo {
    width: 200px;
    height: 40px;
  }

  .home-page-shell .header-actions {
    gap: 6px;
  }

  .home-page-shell .home-login {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  .home-page-shell .reference-news-ticker {
    grid-template-columns: 84px minmax(0, 1fr);
  }

  .home-page-shell .reference-news-label {
    font-size: 10px;
  }

  .home-page-shell .home-hero-copy h1 {
    font-size: 34px;
    line-height: 1.22;
  }

  .home-page-shell .home-section-heading h2 {
    font-size: 20px;
  }

  .home-page-shell .home-topic-card strong {
    font-size: 15px;
  }

  .home-page-shell .home-category-head h2 {
    font-size: 19px;
  }

  .home-page-shell .home-article-copy h3 {
    font-size: 15px;
  }
}

/* Public header and sidebar behavior lock */
body .site-header {
  position: sticky !important;
  top: 0 !important;
  z-index: 100 !important;
}

/* Homepage/category header lock for every public page */
body .site-header,
body .site-header.article-site-header,
body .site-header.category-site-header {
  width: 100%;
  height: 102px !important;
  min-height: 102px !important;
  background: #fff !important;
  border-bottom: 1px solid #e8e8e8;
}

body .site-header .header-main.container,
body .site-header.article-site-header .header-main.container,
body .site-header.category-site-header .header-main.container {
  width: min(1200px, calc(100% - 32px)) !important;
  height: 100px !important;
  min-height: 100px !important;
  gap: 0 !important;
  padding: 0 15px !important;
}

body .site-header .brand,
body .site-header.article-site-header .brand,
body .site-header.category-site-header .brand {
  width: 300px !important;
  min-width: 300px !important;
  max-width: 300px !important;
  flex: 0 0 300px !important;
  gap: 0 !important;
}

body .site-header .source-logo,
body .site-header.article-site-header .source-logo,
body .site-header.category-site-header .source-logo {
  width: 300px !important;
  height: 60px !important;
  max-width: 300px !important;
  border-radius: 0 !important;
  object-fit: contain !important;
}

body .site-header .source-logo-text {
  display: none !important;
}

body .site-header .desktop-nav,
body .site-header.article-site-header .desktop-nav,
body .site-header.category-site-header .desktop-nav {
  height: 100px !important;
  min-width: 0;
  flex: 1 1 auto;
  justify-content: flex-start;
  gap: 0 !important;
  margin: 0 0 0 66px !important;
}

body .site-header .desktop-nav a,
body .site-header.article-site-header .desktop-nav a,
body .site-header.category-site-header .desktop-nav a {
  min-height: 100px;
  justify-content: center;
  color: #242424;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}

body .site-header .desktop-nav a.active,
body .site-header.article-site-header .desktop-nav a.active,
body .site-header.category-site-header .desktop-nav a.active {
  height: 100px !important;
  padding: 0 13px;
  border: 0;
  background: #07810b;
  color: #fff;
}

@media (min-width: 1051px) {
  body .site-header {
    height: 102px !important;
  }

  body .header-main.container {
    height: 100px !important;
  }
}

@media (max-width: 1050px) {
  body .site-header,
  body .header-main.container {
    height: 72px !important;
  }

  body .site-header .header-main.container {
    min-height: 72px !important;
  }

  body .site-header .brand,
  body .site-header.article-site-header .brand {
    width: 240px !important;
    min-width: 240px !important;
    max-width: 240px !important;
    flex-basis: 240px !important;
  }

  body .site-header .source-logo,
  body .site-header.article-site-header .source-logo {
    width: 240px !important;
    height: 48px !important;
  }

  body .site-header .desktop-nav {
    display: none !important;
  }
}

@media (max-width: 680px) {
  body .site-header .brand,
  body .site-header.article-site-header .brand {
    width: 200px !important;
    min-width: 200px !important;
    max-width: 200px !important;
    flex-basis: 200px !important;
  }

  body .site-header .source-logo,
  body .site-header.article-site-header .source-logo {
    width: 200px !important;
    height: 40px !important;
  }
}

@media (min-width: 821px) {
  .article-detail-page .reference-sidebar-sticky,
  .article-detail-page .reference-sidebar-column,
  .category-page-shell .category-archive-sidebar {
    position: sticky !important;
  }

  .article-detail-page .reference-sidebar-sticky,
  .article-detail-page .reference-sidebar-column {
    top: 118px !important;
  }

  .category-page-shell .category-archive-sidebar {
    top: 118px !important;
  }
}

.article-detail-page .reference-comment-form {
  margin-top: 20px;
  padding: 14px;
  border: 1px solid #e2e6e2;
  background: #fff;
}

.article-detail-page .reference-comment-form h2 {
  margin: 0 0 14px;
  padding-bottom: 8px;
  border-bottom: 2px solid #137a3d;
  color: #111;
  font-size: 17px;
}

.article-detail-page .reference-comment-form form {
  display: block;
}

.article-detail-page .reference-comment-form label {
  display: block;
  margin: 0 0 12px;
  color: #59645d;
  font-size: 12px;
}

.article-detail-page .reference-comment-form textarea,
.article-detail-page .reference-comment-form input {
  width: 100%;
  margin-top: 6px;
  border: 1px solid #dfe6e0;
  border-radius: 2px;
  padding: 10px;
  outline: 0;
  background: #fff;
  color: #17231b;
}

.article-detail-page .reference-comment-form textarea {
  resize: vertical;
}

.article-detail-page .reference-comment-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.article-detail-page .reference-comment-fields label:nth-child(3) {
  grid-column: 1 / -1;
}

.article-detail-page .reference-comment-check {
  display: flex !important;
  align-items: center;
  gap: 6px;
}

.article-detail-page .reference-comment-check input {
  width: auto;
  margin: 0;
}

.article-detail-page .reference-comment-form button {
  height: 38px;
  border: 0;
  border-radius: 3px;
  padding: 0 12px;
  background: #137a3d;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.article-detail-page .comment-success {
  color: #137a3d;
  font-size: 12px;
}

.article-detail-page .comment-error {
  color: #b42318;
  font-size: 12px;
}

@media (max-width: 820px) {
  .article-detail-page .reference-comment-fields {
    grid-template-columns: 1fr;
  }

  .article-detail-page .reference-comment-fields label:nth-child(3) {
    grid-column: auto;
  }
}
