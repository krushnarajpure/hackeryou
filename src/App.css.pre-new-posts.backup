  font-size: clamp(34px, 3.8vw, 48px);
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: 0;
}

.home-page-shell .home-hero-copy > p {
  color: #4e5e52;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.7;
}

.home-page-shell .home-hero-copy > p span {
